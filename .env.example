# ================================================
#   Variables d'environnement — Supervision GPON
#   Copiez ce fichier vers .env et remplissez vos valeurs
# ================================================

# ─── Base de données PostgreSQL ──────────────────
# Format : postgresql+pg8000://user:password@host:port/database
DATABASE_URL=postgresql+pg8000://postgres:YOUR_PASSWORD@localhost:5432/supervision_gpon

# ─── Authentification JWT ─────────────────────────
# Générez une clé sécurisée avec : python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=your-super-secret-key-change-in-production

# ─── Configuration de l'application ─────────────
# Durée de validité du token JWT (en minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Environnement ───────────────────────────────
ENVIRONMENT=development
