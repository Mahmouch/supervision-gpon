# ================================================
#   .gitignore — Supervision Réseau GPON
# ================================================

# ─── Variables d'environnement (SECRETS) ────────
.env
.env.local
.env.production
*.env

# ─── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.installed.cfg

# ─── Environnements virtuels ──────────────────────
.venv/
venv/
env/
ENV/
.conda/

# ─── Jupyter Notebooks ───────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ─── Données sensibles / lourdes ─────────────────
# Fichiers Excel / données brutes
*.xlsx
*.xls
*.csv

# Documents personnels / rapports
*.pdf
*.docx
*.pptx
*.ppt
*.doc

# Vidéos
*.mp4
*.avi
*.mov

# Power BI
*.pbix

# ─── Exports temporaires générés ─────────────────
site_web/backend/temp_exports/
temp_exports/

# ─── Dossiers personnels (non-code) ──────────────
pfe_mahmoud/
papier_satge/
images_rapport/

# ─── IDE & Éditeurs ──────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.cursor/

# ─── Système d'exploitation ──────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ─── Logs ────────────────────────────────────────
*.log
logs/

# ─── Base de données locale ──────────────────────
*.sqlite3
*.db
